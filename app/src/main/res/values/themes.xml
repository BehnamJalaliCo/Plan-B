<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlanB" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/planb_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch theme: the system splash shows the brand mark on the app background and
         stays only until stored settings are loaded (see MainActivity). -->
    <style name="Theme.PlanB.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/planb_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/planb_splash_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.PlanB</item>
    </style>
</resources>
